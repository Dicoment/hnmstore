datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model ShoeModel {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  description String
  price       Int

  brandId     String
  brand       Brand               @relation(fields: [brandId], references: [id])

  modelId     String
  model       ShoeModel           @relation(fields: [modelId], references: [id])

  images      ProductImage[]
  sizes       ProductSizeStock[]

  createdAt   DateTime            @default(now())
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  isMain    Boolean  @default(false)

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model Size {
  id        String              @id @default(uuid())
  value     Int                 @unique
  products  ProductSizeStock[]
}

model ProductSizeStock {
  id        String   @id @default(uuid())

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  sizeId    String
  size      Size     @relation(fields: [sizeId], references: [id])

  stock     Int

  @@unique([productId, sizeId])
}