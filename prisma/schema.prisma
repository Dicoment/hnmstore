generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  images    String?
  Product   Product[]
}

model Model {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  Product   Product[]
}

model Product {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String             @unique
  description      String
  price            Int
  brandId          String             @db.Uuid
  modelId          String             @db.Uuid
  createdAt        DateTime?          @default(now()) @db.Timestamptz(6)
  brand_id         String?            @db.Uuid
  model_id         String?            @db.Uuid
  price_regular    Decimal?           @db.Decimal
  price_promo      Decimal?           @db.Decimal
  images           String[]           @default([])
  draft            Boolean?           @default(false)
  Brand            Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Model            Model              @relation(fields: [modelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ProductImage     ProductImage[]
  ProductSizeStock ProductSizeStock[]
}

model ProductImage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url       String
  isMain    Boolean?  @default(false)
  productId String    @db.Uuid
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  Product   Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ProductSizeStock {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  sizeId    String  @db.Uuid
  stock     Int
  Product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Size      Size    @relation(fields: [sizeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Profiles {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name    String
  email        String         @unique
  role         String?        @default("KARYAWAN")
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  address      String?
  nik          String?
  bank_account String?
  password     String?
  Transactions Transactions[]
}

model Size {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  value            String                @unique
  ProductSizeStock ProductSizeStock[]
}

model StockLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_name String
  size_value   String
  old_stock    Int
  new_stock    Int
  type         String
  notes        String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  created_by   String?   @db.Uuid
}

model Transactions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  customer         String?   @default("PELANGGAN UMUM")
  subtotal         Decimal   @default(0) @db.Decimal
  discount         Decimal?  @default(0) @db.Decimal
  total            Decimal   @default(0) @db.Decimal
  items            Json      @default("[]")
  items_count      Int?      @default(0)
  status           String?   @default("SUCCESS")
  return_proof_url String?
  return_reason    String?
  created_by       String?   @db.Uuid
  amount_paid      Decimal?  @default(0) @db.Decimal(15, 2)
  payment_status   String?   @default("LUNAS") @db.VarChar(20)
  due_date         DateTime? @db.Date
  seller_name      String?   @db.VarChar(255)
  payment_method   String?   @db.VarChar(50)
  whatsapp         String?   @db.VarChar(20)
  Profiles         Profiles? @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model WhatsAppConfig {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone_number     String   @default("628")
  template_message String   @default("Halo Admin HnM Store, saya mau pesan produk {produk}...")
  is_active        Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
}
